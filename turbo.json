{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "**/.env.*local"],
  "globalEnv": [
    "OPENAI_API_KEY",
    "NEXT_PUBLIC_ONE_ZERO_FOUR_URL",
    "NEXT_PUBLIC_GITHUB_URL",
    "NEXT_PUBLIC_WS_GAME_URL"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
